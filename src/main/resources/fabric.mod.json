{
  "schemaVersion": 1,
  "id": "tlmo_additions",
  "version": "${version}",
  "name": "TLMO Additions",
  "description": "An addon mod for TouhouLittleMaid-Orihime",
  "authors": [
    "Sh1roCu"
  ],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "cn.sh1rocu.tlmo_additions.client.TLMOAdditionsDataGenerator"
    ],
    "client": [
      "cn.sh1rocu.tlmo_additions.client.TLMOAdditionsClient"
    ],
    "main": [
      "cn.sh1rocu.tlmo_additions.TLMOAdditions"
    ],
    "modmenu": [
      "cn.sh1rocu.tlmo_additions.compat.modmenu.ModMenuApiImpl"
    ],
    "little_maid_extension": [
      "studio.fantasyit.maid_useful_task.UsefulTaskExtension",
      "com.sch246.muhc.maid.LittleMaidCompat",
      "com.mastermarisa.maidbeacon.MaidPlugin"
    ]
  },
  "mixins": [
    "tlmo_additions.mixins.json",
    "maid_useful_task.mixins.json",
    "muhc.mixins.json",
    "maidbeacon.mixins.json"
  ],
  "accessWidener": "tlmo_additions.accesswidener",
  "depends": {
    "fabric-api": "*",
    "minecraft": [
      "1.20.1"
    ],
    "touhou_little_maid": "*"
  }
}
